# Copy this file to ".env" in this same folder and fill in real values.

# Required for the AI mentor hints - get a key at
# https://console.anthropic.com/settings/keys. Everything else (exercises,
# checking, progress tracking) works without one.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional - comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional - how long a submitted program is allowed to run before it's
# killed as a probable infinite loop.
CODE_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
